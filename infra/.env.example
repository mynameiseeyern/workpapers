# Copy to /volume1/docker/workpapers/.env on the NAS. Never commit the real file.
# Tailscale admin → Settings → Keys → Generate auth key (reusable: off, ephemeral: off, tag: tag:workpapers)
TS_AUTHKEY=tskey-auth-REPLACE_ME
# Image tag to run; use a commit SHA tag to pin, "latest" to follow main
WORKPAPERS_TAG=latest
